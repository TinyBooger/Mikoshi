# Exposed to client; do not add secrets here
# Empty on purpose: the frontend calls same-origin (`/api/...`, `/static/...`)
# and Vite's dev proxy forwards both to the backend, exactly like nginx does in
# production. Keeping it empty is what makes dev and prod behave the same —
# pointing it at an absolute backend URL makes every media request cross-origin
# in dev only, which is why CORS problems appear there and nowhere else.
VITE_API_BASE_URL=

# Where the Vite dev proxy sends `/api` and `/static`.
VITE_DEV_PROXY_TARGET=http://localhost:8000
